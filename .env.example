# Stripe secret key (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Price of the full report in cents
REPORT_PRICE_CENTS=900
NEXT_PUBLIC_PRICE_LABEL=$9
# Your deployed URL, e.g. https://agentready.app (falls back to the request origin)
NEXT_PUBLIC_BASE_URL=
# Local dev only: unlock /report?url=... without paying (ignored in production)
DEV_UNLOCK=1
# Local dev only: allow scanning localhost (for the fixtures). Never set in production.
ALLOW_PRIVATE_HOSTS=
